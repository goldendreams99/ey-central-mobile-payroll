<?xml version="1.0" encoding="utf-8"?>
<!-- Payroll: ícono del splash del sistema. Lienzo de 108dp como el vector de Employ; el logo
     ocupa la misma proporción relativa que en Employ para no saltar al pasar al overlay de 64dp. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <size android:width="108dp" android:height="108dp" />
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
    <item
        android:width="23.6dp"
        android:height="23.6dp"
        android:gravity="center"
        android:drawable="@drawable/payroll_splash_logo" />
</layer-list>
