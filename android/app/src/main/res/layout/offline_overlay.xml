<?xml version="1.0" encoding="utf-8"?>
<!-- EY-CENTRAL 2026-10-09 (pedido del usuario): vista PROPIA cuando la webapp no carga (sin conexión o servidor
     caído). Reemplaza la página de error del sistema ("Sin conexión / No se pudo cargar la página"), que delataba
     que esto es una web. Mismo fondo y logo que el splash. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/offline_overlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/splashBackground"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingLeft="32dp"
        android:paddingRight="32dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/splash_logo"
            android:contentDescription="@string/app_name" />

        <TextView
            android:id="@+id/offline_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/offline_title"
            android:textColor="?android:attr/textColorPrimary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/offline_body"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/offline_body"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="15sp" />

        <Button
            android:id="@+id/offline_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:minWidth="160dp"
            android:text="@string/offline_retry" />

    </LinearLayout>

</FrameLayout>
